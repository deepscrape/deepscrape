#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY=

# .env
# Environment variables for the application
PRODUCTION=
EMULATORS=
API_CRAWL4AI_URL=
API_ARACHNEFLY_URL=
PORT=

# Firebase configuration variables
GCP_PROJECT_ID=
API_KEY=
AUTH_DOMAIN=
DATABASE_URL=
PROJECT_ID=
STORAGE_BUCKET=
MESSAGING_SENDER_ID=
APP_ID=
MEASUREMENT_ID=
# reCAPTCHA
RECAPTCHA_KEY=
# Stripe
STRIPE_PUBLIC_KEY=

# API keys for various services
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JINAAI_API_KEY=
GROQ_API_KEY=
CRAWL4AI_API_KEY=
GOOGLE_API_KEY=

# Upstash Redis configuration variables
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_PORT=
UPSTASH_REDIS_REST_USER=
UPSTASH_REDIS_REST_PASSWORD=
UPSTASH_REDIS_REST_TOKEN=
FIREBASE_VAPID_KEY=

# Upstash Box — developer/agent tooling.
# No deployed service reads this, so it is deliberately absent from
# functions/src/config/env.ts and from the deploy workflows. Adding it there
# would put a dev-tool credential into the Cloud Run secret surface for nothing.
#
# TWO names, and they are not interchangeable:
#   UPSTASH_BOX_API_KEY — read by the @upstash/box SDK (the documented path).
#   BOX_API_KEY         — NOT read by anything; it is the name the Upstash MCP
#                         tool asks for as a per-call argument, which means the
#                         caller has to hold the value. That is why the SDK path
#                         is preferred: the key stays in the process environment.
UPSTASH_BOX_API_KEY=

# QStash — the job queue. These ARE runtime values: the service publishes work
# and verifies signatures on the delivery endpoint, so unlike the Box key they
# are declared in functions/src/config/env.ts and belong in the deploy secrets.
#
# LOCAL DEV — use ports that do not collide with this repo's own stack.
# The CLI defaults to 8080, which is exactly where the BFF listens
# (src/proxy.conf.json -> 127.0.0.1:8080), and its log server takes port+1, so
# the defaults fight the dev environment:
#
#   bunx @upstash/qstash-cli@latest dev -port=8090 -log-port=8091
#
# The server then prints the credentials to use, including public test users
# (the "User 1..4" blocks). Copy one set here. It is in-memory — everything
# resets on restart — and its licence permits development and testing only,
# so never point a deployed service at these values.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=