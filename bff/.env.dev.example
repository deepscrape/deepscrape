# Local development config for the BFF. COPY THIS FILE to `.env.dev` and fill it in.
#
# `.env.dev` itself is git-ignored on purpose: it is loaded by the dev build
# (`npm run prbuild:dev`) and must never be committed again. It used to be
# tracked, which also meant `COPY bff/ ./` baked it into the published container
# image at /app/.env.dev.
#
# This file must contain PLACEHOLDERS ONLY. No real keys, no test-mode Stripe
# secret keys, no Redis tokens. If you find a real value in here, it is a bug.

# --- Runtime ---------------------------------------------------------------
# Set "false" for local dev. A truthy value switches billing origins, the Stripe
# key pair and the webhook mode, so leaving this wrong is not a cosmetic problem.
PRODUCTION=false
PORT=8080
APP_ORIGIN=http://127.0.0.1:8080
EMULATORS=

# --- Backends --------------------------------------------------------------
API_ARACHNEFLY_URL=http://127.0.0.1:8082
API_CRAWL4AI_URL=http://127.0.0.1:8000
WEBRAIN_MCP_URL=http://127.0.0.1:9333
WEBRAIN_HTTP_TOKEN=

# --- Firebase / GCP --------------------------------------------------------
GCP_PROJECT_ID=

# --- Upstash Redis (local dev values, not production ones) -----------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_PORT=6379
UPSTASH_REDIS_REST_USER=default
UPSTASH_REDIS_REST_PASSWORD=
UPSTASH_REDIS_REST_TOKEN=

# --- Stripe TEST mode ------------------------------------------------------
# Test-mode values only. The live key lives in Secret Manager and is mounted
# into the deployed revision; it must never appear in a file in this repo.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=

# --- Stripe price ids (TEST account acct_1Qag9KFVGcR0rD8f) -----------------
# Stripe ids do not cross modes: these are the test-mode ids, re-read from the
# API on 2026-10-20. The production values are different ids in the live account.
STRIPE_PRICE_STARTER_PAYG=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_QUARTERLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_PAYG=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_QUARTERLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_QUARTERLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_2000=
