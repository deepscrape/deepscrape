PRODUCTION=
ADMIN_EMAILS="example@gmail.com,admin@example.dev"
API_CRAWL4AI_URL=
API_ARACHNEFLY_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
JINAAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
GCP_PROJECT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_PORT=
UPSTASH_REDIS_REST_USER=
UPSTASH_REDIS_REST_PASSWORD=
UPSTASH_REDIS_REST_TOKEN=
TIGRIS_BUCKET=
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_REGION=auto
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
# Upstash Box — developer/agent tooling. Nothing in this package reads it.
# UPSTASH_BOX_API_KEY is the name the @upstash/box SDK reads; BOX_API_KEY is only
# the argument name the Upstash MCP tool expects.
UPSTASH_BOX_API_KEY=
COOKIE_SECRET=
CSRF_COOKIE_SECRET=
DB_NAME=
AUTHZ_STRICT_ORG_MODE=
STRIPE_PRICE_STARTER_PAYG=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_QUARTERLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO_PAYG=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_QUARTERLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_QUARTERLY=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
STRIPE_PRICE_CREDITS_100=
STRIPE_PRICE_CREDITS_500=
STRIPE_PRICE_CREDITS_2000=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
IP_INTEL_REFRESH_INTERVAL_MS=21600000
IPREGISTRY_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Sandbox (test-mode) pair used by the stripeWebhookTest endpoint. Live values stay in
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET above; each endpoint verifies with its own.
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=

# ── Browser sessions ────────────────────────────────────────────────────────
# webrain is the scraping engine, exposed as MCP over HTTP. Local dev: run
# `webrain mcp --http 9223` and this value works as-is — a loopback bind needs
# no token, which is why it is safe to commit an example of it.
#
# Production MUST differ: point it at the shared worker, which requires the
# bearer token below, and set WEBRAIN_NO_STATE=1 on that worker so a shared
# process can never launch a browser (invariant I2 — the insecure unit is the
# webrain process, not the browser).
WEBRAIN_MCP_URL=http://127.0.0.1:9223

# Which provider /api/crawl uses. It already defaults to `webrain`, so an empty
# WEBRAIN_MCP_URL above leaves the DEFAULT scrape path with no URL at all, and
# nothing validates that at boot. Set this to `crawl4ai` instead if that is the
# intent — make it explicit rather than relying on the default.
SCRAPE_PROVIDER=webrain

# The image a dedicated browser-session machine runs. A REGISTRY PATH, not a
# local path: Fly pulls it, so dev and production differ only by tag, and
# production should pin one.
#
# Left EMPTY on purpose, and the example below is commented out rather than
# filled in — copy this file verbatim and a dedicated session is refused with
# `image is not configured`, which is the intended outcome of "no default by
# policy". A placeholder that looked non-empty would instead reach Fly as an
# invalid reference. The image is built from deploy/browser-session/ and is not
# published yet; see docs/ENV_CONFIG_MATRIX.md 4.1.
# BROWSER_MACHINE_IMAGE=<registry>/<repo>/browser-session:<pinned-tag>
BROWSER_MACHINE_IMAGE=

# Where a browser machine is placed. Must match the default arachnefly already
# falls back to, or the two silently disagree about placement.
BROWSER_MACHINE_REGION=iad

# The bearer the platform sends as `Authorization: Bearer <value>`.
# It MUST equal the worker's WEBRAIN_HTTP_TOKEN: two names for one secret, on
# opposite sides of the same call, and nothing checks that they agree — a
# mismatch shows up as a 401 from the engine, not as a config error.
# Empty is correct for local loopback, where no token is sent at all.
# Never put a real value here: this file is a template.
WEBRAIN_MCP_TOKEN=

# ── webrain pools (runtime-configurable) ────────────────────────────────────
# Both are comma-separated, and neither is read through `env`. Both resolve
# through `WEBRAIN_CONFIG`, so retiring a dead worker or a burned proxy exit is
# an operational action rather than a redeploy: `webrain-config.store.ts` caches
# the resolved document for 30s and falls back to these environment values.

# Proxy exits, `scheme://user:pass@host:port`. Every entry IS a credential, so a
# real value belongs in WEBRAIN_CONFIG or this process environment -- never in a
# log line or an admin table. Empty means calls go out direct.
WEBRAIN_PROXY_POOL=

# Worker base URLs, e.g. http://10.0.0.4:9223,http://10.0.0.5:9223
#
# NOT the same kind of list as the proxies above. A proxy exit is
# interchangeable; a leased worker serves exactly ONE tenant at a time
# (invariant I2), so this list is capacity rather than redundancy. The port is
# part of a worker's identity -- two workers on one host are two entries and two
# separate leases.
#
# Empty means no pool: a browser-backed call is then REFUSED rather than
# answered by a browserless fetch, which would return a JS shell as though it
# were content.
WEBRAIN_WORKER_POOL=
