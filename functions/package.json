{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "lint:fix": "eslint --fix --ext .js,.ts .",
    "test": "tsx --test src/**/*.spec.ts",
    "test:geo-matrix": "tsx --test src/gfunctions/geo-lookup-matrix.spec.ts",
    "audit:redis": "tsx scripts/redis-hygiene-cli.ts",
    "build:angular": "node cp-angular.js",
    "build": "npm run build:angular && tsc",
    "build:watch": "npm run build:angular && tsc --watch",
    "serve": "npm run build && firebase emulators:start --only \"functions,hosting,pubsub,firestore,auth,storage,eventarc,tasks\" --debug ",
    "shell": "npm run build && dotenvx run --overload --env BUILD_ENV=development -f .env.local -- firebase functions:shell",
    "start": "npm run shell",
    "gen:secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\"",
    "migrate:env:json": "node scripts/migrate-env-to-json.cjs",
    "deploy": "node scripts/deploy-with-json-config.cjs",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22.x",
    "npm": "11.11.x"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "@angular/common": "^20.3.30",
    "@angular/compiler": "^20.3.30",
    "@angular/ssr": "^20.3.36",
    "@dotenvx/dotenvx": "^1.75.1",
    "@google-cloud/functions-framework": "^5.0.5",
    "@google-cloud/secret-manager": "^5.6.0",
    "@simplewebauthn/server": "^13.3.3",
    "@types/ua-parser-js": "^0.7.39",
    "@upstash/ratelimit": "^1.2.1",
    "@upstash/redis": "^1.38.4",
    "chalk": "^5.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csurf": "^1.11.0",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^7.3.2",
    "form-data": "^4.0.6",
    "helmet": "^8.3.0",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "rate-limit-redis": "^4.3.1",
    "request-ip": "^3.3.0",
    "resend": "^6.26.0",
    "stripe": "^17.7.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/csurf": "^1.11.5",
    "@types/express": "^4.17.25",
    "@types/geoip-lite": "^1.4.4",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/request-ip": "^0.0.41",
    "@types/stripe": "^8.0.417",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "firebase-functions-test": "^3.5.0",
    "tsx": "^4.23.13",
    "typescript": "^4.9.5"
  },
  "private": true,
  "overrides": {
    "websocket-driver": "0.7.5",
    "@grpc/grpc-js": "1.12.7",
    "protobufjs": "7.6.1",
    "fast-xml-parser": "4.5.5",
    "@google-cloud/storage": {
      "fast-xml-parser": "4.5.5"
    },
    "@types/request": {
      "form-data": "2.5.6"
    },
    "router": {
      "path-to-regexp": "^8.0.0"
    }
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
