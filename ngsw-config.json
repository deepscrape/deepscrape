{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/main-*.js",
          "/scripts-*.js",
          "/polyfills-*.js",
          "/*.css",
          "/*.woff2",
          "!/firebase-*.js",
          "!/__/firebase/*.js"
        ],
        "urls": [
          "https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap",
          "https://fonts.googleapis.com/css2?family=Material+Icons&family=Material+Icons+Outlined&display=swap"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(eot|svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "images",
      "resources": {
        "files": ["/assets/img/**", "/assets/menu/**"]
      },
      "cacheConfig": {
        "strategy": "StaleWhileRevalidate"
      }
    }
  ],
  "navigationRequestStrategy": "freshness"
}
