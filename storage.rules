rules_version = '2';

// Craft rules based on data in your Firestore database.
//
// Watch the database id: application data lives in the NAMED database `easyscrape`, so a rule
// reading `/databases/(default)/...` resolves against a different database and always evaluates
// to false (or errors). This repo has already lost time to that mismatch — see the comment in
// functions/scripts/analytics-audit-cli.ts.
// allow write: if firestore.get(
//    /databases/easyscrape/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    match /uploads/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
